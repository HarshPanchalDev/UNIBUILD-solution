# ─────────────────────────────────────────────────────────────
# UNIBUILD Partner App — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# MySQL 8 connection (create the database first: CREATE DATABASE unibuild CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;)
DATABASE_URL="mysql://unibuild:CHANGE_ME@localhost:3306/unibuild"

# 32+ random characters. Used to hash OTP codes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# ── SMS (one-time codes) ──
# console = DEVELOPMENT ONLY: codes are printed in the server log. Refused in production.
# msg91   = real SMS via MSG91 (needs a DLT-approved OTP template containing ##OTP##). NOT yet tested with real credentials.
SMS_PROVIDER="console"
# Show the code on the sign-in screen as well (development only, ignored in production)
DEV_SHOW_OTP="true"
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""

# Ask staff for a one-time SMS code after the password (needs a mobile on the staff account)
STAFF_OTP_REQUIRED="false"

# Secret for POST /api/cron/daily (24+ characters)
CRON_SECRET="CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING"

# Where uploaded photos, reward images and BUSY files are stored (outside /public)
STORAGE_DIR="./storage"

# ── First accounts (npm run db:seed) ──
# In development these have defaults (owner@unibuild.local / Owner@12345). In production they are required.
SEED_OWNER_NAME="UNIBUILD Owner"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_MOBILE=""
SEED_OWNER_PASSWORD=""
SEED_MANAGER_NAME="Store Manager"
SEED_MANAGER_EMAIL=""
SEED_MANAGER_MOBILE=""
SEED_MANAGER_PASSWORD=""
